# Optional premium basemap. This is a browser-visible public token; restrict it
# to approved origins and styles in the provider dashboard.
VITE_MAPBOX_ACCESS_TOKEN=

# Optional server-side weather integration key. Never prefix server secrets with
# VITE_; Vite embeds VITE_ values into browser assets.
WEATHER_API_KEY=

# Optional server-side NASA FIRMS download key for a separate backend service.
# This DuckDB bulk-file pipeline does not call the FIRMS Area API.
FIRMS_MAP_KEY=
